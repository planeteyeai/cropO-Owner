# Django owner APIs (Docker maps host 8001 → container 8000)
VITE_API_BASE_URL=http://127.0.0.1:8001

# FastAPI manager dashboard (field reports by mobile) — hosted Railway
VITE_FASTAPI_BASE_URL=https://cropoappapis.up.railway.app
# Required by FastAPI HTTPBearer — paste token from Swagger Authorize
VITE_FASTAPI_BEARER_TOKEN=your-fastapi-token-here
